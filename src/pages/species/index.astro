---
import Layout from "../../layouts/Layout.astro";
import GraphicSpecies from "../../components/GraphicSpecies.astro";

const speciesList = ["Adelie", "Gentoo", "Chinstrap"];
---

<Layout title="Toutes les espèces — Manchots de Palmer">
    <main class="ml-40 mt-10">
        <h1>Espèces de manchots</h1>

        <nav class="species-nav" aria-label="Navigation par espèce">
            <ul>
                {speciesList.map((species) => (
                    <li>
                        <a href={`#${species.toLowerCase()}`}>{species}</a>
                    </li>
                ))}
            </ul>
        </nav>

        <div class="slider">
            {speciesList.map((species) => (
                <section class="slide" id={species.toLowerCase()}>
                    <GraphicSpecies species={species} />
                </section>
            ))}
        </div>

        <p>
            <a href="/">Retour à l'accueil</a>
        </p>
    </main>
</Layout>

<style>
    .species-nav ul {
        list-style: none;
        display: flex;
        gap: 1rem;
        padding: 0;
        margin: 0 0 1rem;
    }

    .species-nav a {
        display: inline-block;
        padding: 0.5rem 1rem;
        border: 1px solid #ccc;
        border-radius: 4px;
        text-decoration: none;
        font-weight: bold;
        color: #333;
    }

    .species-nav a:hover {
        background-color: #eee;
    }

    .slider {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        gap: 2rem;
    }

    .slide {
        flex: 0 0 100%;
        scroll-snap-align: start;
    }
</style>

