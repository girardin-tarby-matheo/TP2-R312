---
import Layout from "../../layouts/Layout.astro";
import GraphicSpecies from "../../components/GraphicSpecies.astro";

const speciesList = ["Adelie", "Gentoo", "Chinstrap"];
---

<Layout title="Toutes les espèces — Manchots de Palmer">
    <main class="ml-40 mt-10">
        <h1>Espèces de manchots</h1>

        <nav class="species-nav" aria-label="Navigation par espèce">
            <ul>
                {
                    speciesList.map((species) => (
                        <li>
                            <a
                                class="menu-item inline-block px-4 py-2 border border-gray-300 rounded font-bold text-gray-800 hover:bg-gray-100 transition-colors [.active]:bg-red-200"
                                href={`#${species.toLowerCase()}`}
                            >
                                {species}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>

        <div class="slider">
            {
                speciesList.map((species) => (
                    <section class="slide item" id={species.toLowerCase()}>
                        <GraphicSpecies species={species} />
                    </section>
                ))
            }
        </div>

        <p class="mt-8">
            <a href="/" class="text-blue-600 hover:underline"
                >← Retour à l'accueil</a
            >
        </p>
    </main>
</Layout>

<style>
    .species-nav ul {
        list-style: none;
        display: flex;
        gap: 1rem;
        padding: 0;
        margin: 0 0 1rem;
    }

    .slider {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        gap: 2rem;
    }

    .slide {
        flex: 0 0 100%;
        scroll-snap-align: start;
    }
</style>

<script>
    const menuItems = document.querySelectorAll(".menu-item");
    const items = document.querySelectorAll(".item");

    console.log("menuItems", menuItems);
    console.log("items", items);

    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                const id = entry.target.getAttribute("id");
                const menuItem = document.querySelector(
                    `.menu-item[href="#${id}"]`,
                );
                if (entry.isIntersecting) {
                    menuItem?.classList.add("active");
                } else {
                    menuItem?.classList.remove("active");
                }
            });
        },
        { threshold: 0.5 },
    );

    items.forEach((item) => {
        observer.observe(item);
    });
</script>
