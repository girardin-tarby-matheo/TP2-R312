---
import * as Plot from "@observablehq/plot";
import PlotFigure from "./PlotFigure.astro";
import rawPenguins from "../data/penguins.json";

const { species } = Astro.props;

const penguins = rawPenguins.filter(
    (d) =>
        d.culmen_length_mm &&
        d.culmen_depth_mm &&
        d.body_mass_g &&
        d.flipper_length_mm,
);

const penguinsSpecies = penguins.filter((d) => d.species === species);

const options = {
    title: `Manchots ${species} — Morphologie du bec`,
    subtitle: "Relation entre la longueur et la profondeur du bec (en mm)",
    grid: true,
    color: { legend: true },
    marks: [
        Plot.dot(penguinsSpecies, {
            x: "culmen_length_mm",
            y: "culmen_depth_mm",
            stroke: "island",
        }),
    ],
};
---

<h1>Manchots {species}</h1>
<p>
    Cette page affiche uniquement les données des manchots de l'espèce
    {species} ({penguinsSpecies.length} individus).
</p>
<PlotFigure options={options} />
